generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Club {
  id                 String     @id @default(cuid())
  name               String
  legalName          String?
  taxId              String?
  email              String
  phone              String?
  address            String?
  country            String?
  province           String?
  city               String?
  zipCode            String?
  logoUrl            String?
  timezone           String
  currency           String
  plan               Plan       @default(BASIC)
  status             ClubStatus @default(ACTIVE)
  requiresPrepayment Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  createdBy          String
  updatedBy          String

  users              UserProfile[]
  courts             Court[]
  reservations       Reservation[]
  invoices           Invoice[]
  payments           Payment[]
  waitlistEntries    WaitlistEntry[]
  mercadoPagoAccount ClubMercadoPagoAccount?

  @@map("clubs")
}

enum Plan {
  BASIC
  PRO
  PLUS
  MAX
}

enum ClubStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DISABLED
}

enum SystemRole {
  owner
  player
}

enum MpConnectionStatus {
  NOT_CONNECTED
  CONNECTED
}

// One-to-one per club (see `Club.mercadoPagoAccount`). Tokens are encrypted
// at rest with AES-256-GCM (see lib/mercadopago/tokenCrypto.ts) — never store
// or log plaintext access/refresh tokens.
model ClubMercadoPagoAccount {
  id     String             @id @default(cuid())
  clubId String             @unique
  club   Club               @relation(fields: [clubId], references: [id])
  status MpConnectionStatus @default(NOT_CONNECTED)

  // Mercado Pago's own seller identifiers for this OAuth grant.
  mpUserId String?
  liveMode Boolean @default(false)
  scope    String?

  // AES-256-GCM ciphertext (iv + authTag + data, see tokenCrypto.ts) — never
  // plaintext.
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?

  connectedAt      DateTime?
  disconnectedAt   DateTime?
  lastRefreshError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("club_mercadopago_accounts")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  // Set by the Clerk `user.deleted` webhook (anonymize, not hard-delete —
  // see docs/COMPLIANCE.md, derecho de supresión). Kept distinct from
  // INACTIVE, which an owner can set to deactivate a player's access without
  // their Clerk account being deleted.
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum PreferredSide {
  forehand
  backhand
}

enum DominantHand {
  right
  left
}

model UserProfile {
  id              String         @id
  role            SystemRole     @default(player)
  clubId          String?
  club            Club?          @relation(fields: [clubId], references: [id])
  displayName     String
  firstName       String?
  lastName        String?
  email           String
  photoURL        String?
  phone           String?
  address         String?
  country         String?
  province        String?
  city            String?
  zipCode         String?
  gender          Gender?
  padelCategory   Int?
  preferredSide   PreferredSide?
  dominantHand    DominantHand?
  status          UserStatus     @default(ACTIVE)
  lastLogin       DateTime?
  // Set server-side at onboarding submit time (see app/api/onboarding/route.ts).
  // Nullable because existing rows predate this field; the onboarding Terms
  // step checkbox also self-certifies the user is 18+ (see docs/COMPLIANCE.md
  // — self-certification, no DOB collection), so this single timestamp
  // covers both terms acceptance and the age gate.
  acceptedTermsAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       String
  updatedBy       String

  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]

  @@index([clubId])
  @@map("user_profiles")
}

model Court {
  id                  String    @id @default(cuid())
  clubId              String
  club                Club      @relation(fields: [clubId], references: [id])
  name                String
  surface             String?
  indoor              Boolean   @default(false)
  color               String?
  photoUrl            String?
  slotDurationMinutes Int       @default(90)
  reservationFee      Float?
  courtPrice          Float?
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String?
  updatedBy           String?
  deletedAt           DateTime?
  deletedBy           String?

  availability    CourtAvailability[]
  closures        CourtClosure[]
  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]

  @@index([clubId, active])
  @@map("courts")
}

model CourtAvailability {
  id        String   @id @default(cuid())
  courtId   String
  court     Court    @relation(fields: [courtId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([courtId, dayOfWeek])
  @@map("court_availability")
}

model CourtClosure {
  id          String    @id @default(cuid())
  courtId     String
  court       Court     @relation(fields: [courtId], references: [id])
  startsAt    DateTime
  endsAt      DateTime
  reason      String
  createdAt   DateTime  @default(now())
  createdBy   String
  cancelledAt DateTime?
  cancelledBy String?

  @@index([courtId, startsAt, endsAt])
  @@map("court_closures")
}

enum ReservationStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Reservation {
  id               String            @id @default(cuid())
  clubId           String
  club             Club              @relation(fields: [clubId], references: [id])
  userId           String
  user             UserProfile       @relation(fields: [userId], references: [id])
  userName         String
  courtId          String
  court            Court             @relation(fields: [courtId], references: [id])
  courtName        String
  status           ReservationStatus @default(CONFIRMED)
  scheduledStart   DateTime
  scheduledEnd     DateTime
  notes            String?
  paymentExpiresAt DateTime?
  cancelledAt      DateTime?
  cancelledBy      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String?
  updatedBy        String?

  invoices Invoice[]

  @@index([clubId, scheduledStart])
  @@index([clubId, userId])
  @@index([clubId, courtId])
  @@index([clubId, status])
  @@map("reservations")
}

enum WaitlistEntryStatus {
  WAITING
  NOTIFIED
}

model WaitlistEntry {
  id             String              @id @default(cuid())
  clubId         String
  club           Club                @relation(fields: [clubId], references: [id])
  courtId        String
  court          Court               @relation(fields: [courtId], references: [id])
  courtName      String
  userId         String
  user           UserProfile         @relation(fields: [userId], references: [id])
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         WaitlistEntryStatus @default(WAITING)
  notifiedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([courtId, scheduledStart, userId])
  @@index([courtId, scheduledStart, status])
  @@map("waitlist_entries")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  DIGITAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Invoice {
  id            String        @id @default(cuid())
  clubId        String
  club          Club          @relation(fields: [clubId], references: [id])
  userId        String
  userName      String
  reservationId String?
  reservation   Reservation?  @relation(fields: [reservationId], references: [id])
  number        Int
  status        InvoiceStatus @default(DRAFT)
  currency      String
  items         Json
  subtotal      Float
  tax           Float         @default(0)
  discount      Float         @default(0)
  total         Float
  notes         String?
  issuedAt      DateTime?
  paidAt        DateTime?
  voidedAt      DateTime?
  voidedBy      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String?
  updatedBy     String?

  payments Payment[]

  @@unique([clubId, number])
  @@index([clubId, status])
  @@index([clubId, userId])
  @@index([clubId, createdAt])
  @@map("invoices")
}

model Payment {
  id        String        @id @default(cuid())
  clubId    String
  club      Club          @relation(fields: [clubId], references: [id])
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  method    PaymentMethod
  amount    Float
  currency  String
  status    PaymentStatus @default(COMPLETED)
  reference String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())
  createdBy String?

  @@map("payments")
}

enum NotificationType {
  RESERVATION_REMINDER
  RESERVATION_CANCELLED
  PAYMENT_CONFIRMED
  WAITLIST_SLOT_AVAILABLE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id             String             @id @default(cuid())
  clubId         String
  type           NotificationType
  recipientId    String
  recipientEmail String
  title          String
  message        String
  status         NotificationStatus @default(PENDING)
  failureReason  String?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())

  @@index([clubId, status])
  @@index([clubId, type, recipientId])
  @@map("notifications")
}

model AuditLog {
  id              String   @id @default(cuid())
  clubId          String?
  userId          String
  userDisplayName String   @default("")
  action          String
  entity          String
  entityId        String
  metadata        Json?
  timestamp       DateTime @default(now())

  @@index([clubId, timestamp(sort: Desc)])
  @@index([clubId, entity])
  @@map("audit_logs")
}
