generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Club {
  id                 String             @id @default(cuid())
  name               String
  legalName          String?
  taxId              String?
  // Enforced unique — a Club row is only ever created once, at the very end
  // of onboarding (right after Terms acceptance), so this email is
  // permanently claimed even if the club's owner account is later deleted
  // (see app/api/webhooks/clerk/route.ts's deactivation-on-owner-deletion —
  // the Club row survives, INACTIVE, not gone). Reusing it needs a human:
  // see app/api/onboarding/route.ts's P2002 handler.
  email              String             @unique
  phone              String?
  whatsappNumber     String?
  address            String?
  country            String?
  province           String?
  city               String?
  zipCode            String?
  logoUrl            String?
  timezone           String
  currency           String
  plan               Plan               @default(BASIC)
  // Per-club override of the plan's default court limit (see
  // lib/consts/planPricing.ts's PLAN_COURT_LIMITS) — only ever set by an
  // admin (AdminClubSettingsView), never by the owner's own settings form.
  // BASIC/PRO/PLUS have a fixed limit in code; MAX has none, so this is the
  // ONLY source of a court limit for a MAX club — null means "no limit set
  // yet" and is treated as unlimited, not zero.
  courtLimit         Int?
  status             ClubStatus         @default(ACTIVE)
  // Admin approval queue gate (see lib/auth/adminProfile.ts's isAdmin and
  // lib/mercadopago/operationalStatus.ts's PENDING_APPROVAL cause). Defaults
  // to APPROVED — NOT PENDING — so this migration is a no-op for every
  // club that already exists today (dev AND prod, whenever it eventually
  // runs there): the ALTER TABLE's own column default grandfathers every
  // pre-existing row as already-approved. Only the onboarding club-creation
  // path (app/api/onboarding/route.ts -> createClub) explicitly overrides
  // this default to PENDING for a brand-new club. The only other writer that
  // sets APPROVED explicitly is activateFreePlan's hidden FREE-plan testing
  // bypass (core/billing/services/membership.service.ts) — everything else
  // (including admin approve/reject actions) reads/writes this field without
  // ever touching the schema default.
  approvalStatus     ClubApprovalStatus @default(APPROVED)
  requiresPrepayment Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdBy          String
  updatedBy          String

  users                  UserProfile[]
  courts                 Court[]
  reservations           Reservation[]
  invoices               Invoice[]
  payments               Payment[]
  waitlistEntries        WaitlistEntry[]
  mercadoPagoAccount     ClubMercadoPagoAccount?
  membershipSubscription ClubMembershipSubscription?
  operatingHours         ClubOperatingHours[]
  bankTransferAccount    ClubBankTransferAccount?
  tournaments            Tournament[]

  @@map("clubs")
}

enum Plan {
  BASIC
  PRO
  PLUS
  MAX
  // Hidden, admin-only tier — never offered through the real plan picker
  // (components/PlanSelectionModal/consts.ts's PLAN_ORDER omits it).
  // Activated only via activateFreePlan (core/billing/services/
  // membership.service.ts) to unblock a club's dashboard for internal
  // testing without a real Mercado Pago subscription.
  FREE
}

enum ClubStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DISABLED
}

enum ClubApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SystemRole {
  owner
  player
}

enum MpConnectionStatus {
  NOT_CONNECTED
  CONNECTED
}

// One-to-one per club (see `Club.mercadoPagoAccount`). Tokens are encrypted
// at rest with AES-256-GCM (see lib/mercadopago/tokenCrypto.ts) — never store
// or log plaintext access/refresh tokens.
model ClubMercadoPagoAccount {
  id     String             @id @default(cuid())
  clubId String             @unique
  club   Club               @relation(fields: [clubId], references: [id])
  status MpConnectionStatus @default(NOT_CONNECTED)

  // Mercado Pago's own seller identifiers for this OAuth grant.
  mpUserId String?
  liveMode Boolean @default(false)
  scope    String?

  // Human-readable identity of the connected account (from GET /users/me),
  // fetched best-effort at connect time — used only to display which
  // Mercado Pago account a club is linked to. Never used for auth.
  mpEmail    String?
  mpNickname String?

  // AES-256-GCM ciphertext (iv + authTag + data, see tokenCrypto.ts) — never
  // plaintext.
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?

  connectedAt      DateTime?
  disconnectedAt   DateTime?
  lastRefreshError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("club_mercadopago_accounts")
}

enum MembershipCycle {
  MONTHLY
  ANNUAL
}

enum MembershipRenewalMode {
  AUTO
  MANUAL
}

enum MembershipStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

// One-to-one per club (see `Club.membershipSubscription`). Tracks the
// club's OWN payment to the platform for its membership plan/tier — the
// opposite money direction from `ClubMercadoPagoAccount` (which is the
// club's OAuth-connected account for RECEIVING reservation payments). All MP
// calls for this model go through the platform's own Mercado Pago client
// (see lib/mercadopago/platformClient.ts, Phase 2), never a club's OAuth
// token. See design.md's "Membership state storage" and "MP client for
// membership" decisions.
model ClubMembershipSubscription {
  id     String @id @default(cuid())
  clubId String @unique
  club   Club   @relation(fields: [clubId], references: [id])

  plan         Plan
  pendingPlan  Plan? // applied at next period boundary — no mid-cycle proration (see spec)
  cycle        MembershipCycle
  pendingCycle MembershipCycle?
  renewalMode  MembershipRenewalMode
  status       MembershipStatus      @default(PENDING)

  // Never hardcoded — every MP call for this model carries currency as an
  // explicit parameter (see spec's "Currency Threaded as Explicit Parameter").
  currency String

  mpPreapprovalId String? // MONTHLY only — real MP Subscriptions/Preapproval id
  mpPreferenceId  String? // ANNUAL only — one-time Checkout Pro preference id
  mpCustomerId    String?
  mpCardId        String?

  // Owner-confirmed cardholder identification (DNI/CUIT type + number),
  // saved only when the owner explicitly opts in via the "Save this ID for
  // future payments" checkbox during MONTHLY checkout — remembered so a
  // later renewal/plan-change card re-collection can prefill the Mercado
  // Pago Card Payment Brick's identification field again instead of always
  // falling back to the club's own onboarding-collected `Club.taxId`.
  payerIdentificationType   String?
  payerIdentificationNumber String?

  // Authoritative for ANNUAL only (no native MP trial-without-charge exists
  // for one-off Checkout Pro). Informational mirror for MONTHLY — MP's own
  // `preapproval_plan.auto_recurring.free_trial` is authoritative there.
  trialEndsAt DateTime?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  pastDueSince DateTime?
  // AUTO mode: informational/missed-webhook-backstop only — MP's own
  // recycling/dunning timeline is the real clock, this never independently
  // shortens or extends it. MANUAL mode: authoritative lockout deadline,
  // evaluated by the cron sweep (no MP-side signal exists for this mode).
  pastDueUntil DateTime?

  // Idempotency guard so a re-delivered/duplicate MP webhook never replays
  // a state transition twice (see design.md's state machine decision).
  lastWebhookEventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("club_membership_subscriptions")
}

// Admin-configurable trial length per plan tier, one row per `Plan` (builds
// on the existing `welcomeFreeMonths` concept — see spec's "Admin-
// Configurable Trial Length Per Plan"). Edited via a static-secret-guarded
// route (Phase 5); broader admin-role auth is explicitly out of scope here.
model MembershipTrialConfig {
  plan      Plan     @id
  trialDays Int
  updatedAt DateTime @updatedAt
  updatedBy String

  @@map("membership_trial_configs")
}

// System-managed cache of the Mercado Pago `preapproval_plan` object created
// for a given (plan tier, currency) pair, so a MONTHLY checkout reuses one
// plan object per tier+currency instead of creating a near-duplicate on
// every single checkout (post-archive optimization — see this batch's
// apply-progress notes). Composite-keyed by (plan, currency) rather than
// plan alone: `Club.currency` is a free-form per-club field (spec's
// "Currency Threaded as Explicit Parameter"), so a plan object created for
// one currency must never be reused for a club billed in a different
// currency. Deliberately a separate table from `MembershipTrialConfig`
// rather than a field on it: that model's `trialDays`/`updatedBy` are
// required admin-authored fields, but a cache write can legitimately happen
// before any admin has ever configured a trial override for that tier.
model MembershipPreapprovalPlanCache {
  plan              Plan
  currency          String
  preapprovalPlanId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@id([plan, currency])
  @@map("membership_preapproval_plan_cache")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  // Set by the Clerk `user.deleted` webhook (anonymize, not hard-delete —
  // see docs/COMPLIANCE.md, derecho de supresión). Kept distinct from
  // INACTIVE, which an owner can set to deactivate a player's access without
  // their Clerk account being deleted.
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum PreferredSide {
  forehand
  backhand
}

enum DominantHand {
  right
  left
}

model UserProfile {
  id              String         @id
  role            SystemRole     @default(player)
  // Additive, independent of `role` — a player can be `isAdmin: true` and
  // keep every normal player capability (booking, browsing courts, etc.)
  // unchanged. Deliberately NOT a third SystemRole value (see
  // core/users/types's SystemRole comment): this gates a separate set of
  // admin-only surfaces inside /dashboard, unrelated to the pre-existing
  // Clerk `publicMetadata.isAdmin`-based internal testing tool at
  // /admin/club-status (see lib/auth/admin.ts's isAdminUser — that
  // mechanism is untouched by this field).
  isAdmin         Boolean        @default(false)
  clubId          String?
  club            Club?          @relation(fields: [clubId], references: [id])
  displayName     String
  firstName       String?
  lastName        String?
  // Unique (2026-09-06): more than one person must never register with the
  // same email — see docs/ADMIN_BOOTSTRAP.md's own warning about duplicate
  // rows this app used to allow. app/api/onboarding/route.ts catches the
  // resulting P2002 and returns a friendly "already registered" error
  // instead of a raw 500.
  email           String         @unique
  photoURL        String?
  phone           String?
  address         String?
  country         String?
  province        String?
  city            String?
  zipCode         String?
  gender          Gender?
  padelCategory   Int?
  preferredSide   PreferredSide?
  dominantHand    DominantHand?
  status          UserStatus     @default(ACTIVE)
  lastLogin       DateTime?
  // Set server-side at onboarding submit time (see app/api/onboarding/route.ts).
  // Nullable because existing rows predate this field; the onboarding Terms
  // step checkbox also self-certifies the user is 18+ (see docs/COMPLIANCE.md
  // — self-certification, no DOB collection), so this single timestamp
  // covers both terms acceptance and the age gate.
  acceptedTermsAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       String
  updatedBy       String

  reservations        Reservation[]
  waitlistEntries     WaitlistEntry[]
  reservationPartners ReservationPartner[]
  player1AsTeam       TournamentTeam[]     @relation("TournamentTeamPlayer1")
  player2AsTeam       TournamentTeam[]     @relation("TournamentTeamPlayer2")

  @@index([clubId])
  @@map("user_profiles")
}

// NOT modeled here (Prisma has no schema syntax for a case-insensitive,
// partial-WHERE unique index): a Postgres unique index
// (`courts_no_duplicate_active_name`, migration 20260906020000) prevents two
// live (non-soft-deleted) courts in the same club from sharing a name,
// case-insensitively — the race-proof backstop behind
// assertNoDuplicateCourtName's application-level (best-effort) check. See
// that migration file for the full reasoning before changing this table.
model Court {
  id                  String    @id @default(cuid())
  clubId              String
  club                Club      @relation(fields: [clubId], references: [id])
  name                String
  courtNumber         Int?
  surface             String?
  indoor              Boolean   @default(false)
  color               String?
  wallType            String?
  lighting            Boolean   @default(false)
  netType             String?
  photoUrl            String?
  slotDurationMinutes Int       @default(90)
  reservationFee      Float?
  courtPrice          Float?
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String?
  updatedBy           String?
  deletedAt           DateTime?
  deletedBy           String?

  availability    CourtAvailability[]
  closures        CourtClosure[]
  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]

  @@index([clubId, active])
  @@map("courts")
}

// Club-level "normally open" days/hours — distinct from CourtAvailability
// (which drives actual bookable slots per court). Onboarding's operating-
// hours step writes these; a newly-created court with no explicit
// availability of its own is seeded from these rows (see
// resolveDefaultCourtAvailability in core/clubs/services/operatingHours.service.ts).
// No @@unique — same "delete all, recreate on every write" convention as
// CourtAvailability, enforced in the service layer rather than the DB.
model ClubOperatingHours {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId, dayOfWeek])
  @@map("club_operating_hours")
}

// One-to-one per club (see `Club.bankTransferAccount`). Lets an owner accept
// manual bank-transfer payments as an alternative payout destination to
// Mercado Pago — club-side configuration only; no player-facing checkout
// path reads this yet.
model ClubBankTransferAccount {
  id                String   @id @default(cuid())
  clubId            String   @unique
  club              Club     @relation(fields: [clubId], references: [id])
  bankName          String
  cbu               String
  alias             String?
  accountHolderName String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  updatedBy         String

  @@map("club_bank_transfer_accounts")
}

model CourtAvailability {
  id        String   @id @default(cuid())
  courtId   String
  court     Court    @relation(fields: [courtId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([courtId, dayOfWeek])
  @@map("court_availability")
}

model CourtClosure {
  id          String    @id @default(cuid())
  courtId     String
  court       Court     @relation(fields: [courtId], references: [id])
  startsAt    DateTime
  endsAt      DateTime
  reason      String
  createdAt   DateTime  @default(now())
  createdBy   String
  cancelledAt DateTime?
  cancelledBy String?

  @@index([courtId, startsAt, endsAt])
  @@map("court_closures")
}

enum ReservationStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// NOT modeled here (Prisma has no schema syntax for it): a Postgres EXCLUDE
// constraint (`reservations_no_overlapping_confirmed`, migration
// 20260905200000) prevents two overlapping CONFIRMED reservations for the
// same courtId at the DB level — the race-proof backstop behind
// checkCourtConflict's application-level (best-effort) check. See that
// migration file for the full reasoning before changing this table.
model Reservation {
  id               String            @id @default(cuid())
  clubId           String
  club             Club              @relation(fields: [clubId], references: [id])
  userId           String
  user             UserProfile       @relation(fields: [userId], references: [id])
  userName         String
  courtId          String
  court            Court             @relation(fields: [courtId], references: [id])
  courtName        String
  status           ReservationStatus @default(CONFIRMED)
  scheduledStart   DateTime
  scheduledEnd     DateTime
  notes            String?
  paymentExpiresAt DateTime?
  paymentMethod    String?
  expiryNotifiedAt DateTime?
  cancelledAt      DateTime?
  cancelledBy      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String?
  updatedBy        String?

  invoices Invoice[]
  partners ReservationPartner[]

  @@index([clubId, scheduledStart])
  @@index([clubId, userId])
  @@index([clubId, courtId])
  @@index([clubId, status])
  @@map("reservations")
}

// Optional, additive tagging: the booker of a Reservation can tag up to 3
// other registered players (UserProfile rows) they're playing with, at
// booking-creation time — no confirmation/consent needed from the tagged
// player (see docs: Latest Partner spec, "played together" counts the
// instant the booker tags them). Purely additive — a Reservation with no
// rows here behaves exactly as before this model existed. Drives the
// PlayerOverview "Latest Partner" card (core/reservations/services/
// reservationPartners.service.ts) rather than any confirmation/consent flow.
model ReservationPartner {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  playerId      String
  player        UserProfile @relation(fields: [playerId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([reservationId, playerId])
  @@index([playerId])
  @@map("reservation_partners")
}

enum WaitlistEntryStatus {
  WAITING
  NOTIFIED
}

model WaitlistEntry {
  id             String              @id @default(cuid())
  clubId         String
  club           Club                @relation(fields: [clubId], references: [id])
  courtId        String
  court          Court               @relation(fields: [courtId], references: [id])
  courtName      String
  userId         String
  user           UserProfile         @relation(fields: [userId], references: [id])
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         WaitlistEntryStatus @default(WAITING)
  notifiedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([courtId, scheduledStart, userId])
  @@index([courtId, scheduledStart, status])
  @@map("waitlist_entries")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  DIGITAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Invoice {
  id            String        @id @default(cuid())
  clubId        String
  club          Club          @relation(fields: [clubId], references: [id])
  userId        String
  userName      String
  reservationId String?
  reservation   Reservation?  @relation(fields: [reservationId], references: [id])
  number        Int
  status        InvoiceStatus @default(DRAFT)
  currency      String
  items         Json
  subtotal      Float
  tax           Float         @default(0)
  discount      Float         @default(0)
  total         Float
  notes         String?
  issuedAt      DateTime?
  paidAt        DateTime?
  voidedAt      DateTime?
  voidedBy      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String?
  updatedBy     String?

  payments Payment[]

  @@unique([clubId, number])
  @@index([clubId, status])
  @@index([clubId, userId])
  @@index([clubId, createdAt])
  @@map("invoices")
}

model Payment {
  id        String        @id @default(cuid())
  clubId    String
  club      Club          @relation(fields: [clubId], references: [id])
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  method    PaymentMethod
  amount    Float
  currency  String
  status    PaymentStatus @default(COMPLETED)
  reference String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())
  createdBy String?

  @@map("payments")
}

enum NotificationType {
  RESERVATION_REMINDER
  RESERVATION_CANCELLED
  PAYMENT_CONFIRMED
  WAITLIST_SLOT_AVAILABLE
  CLUB_APPROVED
  CLUB_REJECTED
  CLUB_SUSPENDED
  PAYMENT_RECEIVED
  MEMBERSHIP_PAST_DUE
  CLUB_PENDING_APPROVAL
  SYSTEM_JOB_FAILED
  RESERVATION_PAYMENT_CONFLICT
  CLUB_OPERATIONAL_READY
  ADMIN_ACCESS_GRANTED
  ADMIN_ACCESS_REVOKED
  MEMBERSHIP_CANCELLED
  RESERVATION_UPDATED
  PROFILE_UPDATED_BY_ADMIN
  CLUB_UPDATED_BY_ADMIN
  RESERVATION_PAYMENT_HOLD_EXPIRED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  // In-app-only notifications (sendEmail: false in dispatch()) skip Resend
  // entirely and land here instead of a real FAILED — distinct from a
  // genuine delivery failure so admin-facing email diagnostics elsewhere
  // aren't polluted with rows that were never supposed to be emailed.
  SKIPPED
}

model Notification {
  id             String             @id @default(cuid())
  // Nullable: SYSTEM_JOB_FAILED is a platform-wide event, not scoped to any
  // one club. Not a real Prisma relation (plain string column), so relaxing
  // this is a safe, non-breaking migration for existing rows.
  clubId         String?
  type           NotificationType
  recipientId    String
  recipientEmail String
  title          String
  message        String
  status         NotificationStatus @default(PENDING)
  failureReason  String?
  sentAt         DateTime?
  // Bell read/unread state — null means unread. Set in bulk via
  // "mark all as read", not per-notification (see notifications feature).
  readAt         DateTime?
  createdAt      DateTime           @default(now())

  @@index([clubId, status])
  @@index([clubId, type, recipientId])
  @@index([recipientId, readAt])
  @@map("notifications")
}

enum SystemJobKind {
  CRON
  WEBHOOK
}

enum SystemJobStatus {
  SUCCESS
  FAILURE
}

// Minimal shared observability log for the app's cron jobs and webhook
// receivers (see core/systemJobs/services/systemJobs.service.ts) — before
// this there was zero infrastructure tracking whether any of them actually
// ran/succeeded. `name` is one of the small set of hardcoded job names in
// core/systemJobs/consts.ts (e.g. "notifications" for CRON,
// "mercadopago" for WEBHOOK) rather than a relation, since these jobs are
// not domain entities.
model SystemJobLog {
  id           String          @id @default(cuid())
  kind         SystemJobKind
  name         String
  status       SystemJobStatus
  startedAt    DateTime
  finishedAt   DateTime
  errorMessage String?
  createdAt    DateTime        @default(now())

  @@index([kind, name, createdAt])
  @@map("system_job_logs")
}

model AuditLog {
  id              String   @id @default(cuid())
  clubId          String?
  userId          String
  userDisplayName String   @default("")
  action          String
  entity          String
  entityId        String
  metadata        Json?
  timestamp       DateTime @default(now())

  @@index([clubId, timestamp(sort: Desc)])
  @@index([clubId, entity])
  @@map("audit_logs")
}

// Build order slice 1 of the Tournaments feature (see the approved plan) —
// schema + registration core only. Deliberately does NOT yet include
// TournamentGroup/TournamentMatch/MatchSet or the knockout-bracket fields
// (nextMatchId/knockoutRound/etc.) described for TournamentTeam in the full
// plan — those belong to later, separate slices with no consumer yet in this
// one. `TournamentTeam.groupId` from the full plan is likewise omitted here
// for the same reason (no TournamentGroup model exists yet in this slice).
enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  GROUPS_LOCKED
  KNOCKOUT
  COMPLETED
  CANCELLED
}

// Mirrors TournamentStatus's lifecycle at the per-category level (see the
// plan's "each category has its own independent groups/bracket/standings").
enum TournamentCategoryStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  GROUPS_LOCKED
  KNOCKOUT
  COMPLETED
  CANCELLED
}

enum TournamentTeamStatus {
  REGISTERED
  ADVANCED
  ELIMINATED
  CHAMPION
  WITHDRAWN
}

model Tournament {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id])

  name        String
  description String?
  status      TournamentStatus @default(DRAFT)

  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  // Drives the future "New"/"Open" nav badge (slice 5) — set once, the
  // moment publishTournament transitions DRAFT -> REGISTRATION_OPEN.
  publishedAt          DateTime?
  startDate            DateTime?
  endDate              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  categories TournamentCategory[]

  @@index([clubId, status])
  @@index([status, registrationOpensAt, registrationClosesAt])
  @@map("tournaments")
}

model TournamentCategory {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  name   String
  status TournamentCategoryStatus @default(DRAFT)

  // Padel category bounds (1 = strongest .. 8 = beginner — see
  // core/users/consts.ts's PADEL_CATEGORY_OPTIONS). Both optional: an
  // unrestricted category sets neither.
  minCategoryLevel Int?
  maxCategoryLevel Int?

  groupCount       Int
  advancesPerGroup Int
  maxTeams         Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams TournamentTeam[]

  // Added in slice 2 ("Owner group + scoring tools") — see TournamentGroup/
  // TournamentMatch's own comments.
  groups  TournamentGroup[]
  matches TournamentMatch[]

  @@index([tournamentId])
  @@map("tournament_categories")
}

// A team is always exactly a pair (flat player1Id/player2Id FKs, same
// convention as ReservationPartner rather than a join table — see the plan's
// data model decision). `@@unique` per player per category is the DB-level
// backstop behind registerTeam's own friendly pre-check (one team per player
// per category).
model TournamentTeam {
  id                   String             @id @default(cuid())
  tournamentCategoryId String
  tournamentCategory   TournamentCategory @relation(fields: [tournamentCategoryId], references: [id])

  player1Id String
  player1   UserProfile @relation("TournamentTeamPlayer1", fields: [player1Id], references: [id])
  player2Id String
  player2   UserProfile @relation("TournamentTeamPlayer2", fields: [player2Id], references: [id])

  // Average of both partners' padelCategory at registration time, rounded to
  // the nearest integer; null when either partner has no padelCategory set.
  // Snapshotted rather than recomputed later so a subsequent profile edit
  // never silently reshuffles an already-registered team's seeding.
  combinedCategoryLevel Int?

  status TournamentTeamStatus @default(REGISTERED)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String
  // Mirrors CourtClosure's cancelledAt/cancelledBy pair for the same reason:
  // a terminal state transition (here, withdrawTeam) worth its own audit
  // trail beyond the generic updatedAt.
  withdrawnAt DateTime?
  withdrawnBy String?

  // Added in slice 2 ("Owner group + scoring tools") — deliberately omitted
  // by slice 1 since no TournamentGroup model existed yet then. Nullable:
  // a team sits ungrouped until setGroupsManually/generateGroupsAutomatically
  // assigns it.
  groupId String?
  group   TournamentGroup? @relation(fields: [groupId], references: [id])

  matchesAsTeamA TournamentMatch[] @relation("TournamentMatchTeamA")
  matchesAsTeamB TournamentMatch[] @relation("TournamentMatchTeamB")
  matchesWon     TournamentMatch[] @relation("TournamentMatchWinner")

  @@unique([tournamentCategoryId, player1Id])
  @@unique([tournamentCategoryId, player2Id])
  @@index([tournamentCategoryId, status])
  @@index([groupId])
  @@map("tournament_teams")
}

// Build order slice 2 ("Owner group + scoring tools") of the Tournaments
// feature — see the approved plan. Only GROUP-stage rows are ever produced by
// this slice; KNOCKOUT is included now purely for forward-compatibility with
// slice 3 (bracket progression), which is the first slice to actually create
// those rows. Deliberately does NOT yet add a `KnockoutRound` enum or
// TournamentMatch.knockoutRound/nextMatchId/nextMatchSlot bracket-progression
// fields — meaningless with no knockout rows existing yet; those belong to
// slice 3.
enum TournamentMatchStage {
  GROUP
  KNOCKOUT
}

// Per the plan's list this also allows IN_PROGRESS, but slice 2 (full score
// entry only, no live scoring UI) never produces that state, so it's omitted
// here rather than half-supporting an unused status. Flagged in the slice 2
// report — add it in whichever later slice actually needs it.
enum TournamentMatchStatus {
  SCHEDULED
  COMPLETED
  WALKOVER
  CANCELLED
}

model TournamentGroup {
  id                   String             @id @default(cuid())
  tournamentCategoryId String
  tournamentCategory   TournamentCategory @relation(fields: [tournamentCategoryId], references: [id])

  name     String
  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams   TournamentTeam[]
  matches TournamentMatch[]

  @@unique([tournamentCategoryId, name])
  @@index([tournamentCategoryId])
  @@map("tournament_groups")
}

// Build order slice 3 ("Knockout + standings") of the Tournaments feature —
// see the approved plan. Fixed ladder (caps a category's bracket at 32
// teams — plenty for a club event, per the plan's explicit decision).
enum KnockoutRound {
  ROUND_OF_32
  ROUND_OF_16
  QUARTERFINAL
  SEMIFINAL
  FINAL
}

// `winnerTeamId` is a denormalized cache, always re-derivable from this
// match's MatchSet rows (source of truth) via deriveMatchResult — see
// core/tournaments/services/matchResult.ts. teamA/teamB are nullable now
// because a slice-3 knockout match may be created before both of its feeder
// matches have resolved; every slice 2 GROUP match always has both set at
// creation time (generateRoundRobinMatches never emits an incomplete
// pairing). Note: the plan floated a separate `walkoverTeamId` field for
// "which team a WALKOVER promotes" — slice 2's `winnerTeamId` already covers
// that (recordWalkover writes the winner there same as a scored win), so no
// extra column was added; see bracketBuilder.ts/matches.service.ts's
// generateKnockoutBracket doc comment for the confirmation.
model TournamentMatch {
  id                   String             @id @default(cuid())
  tournamentCategoryId String
  tournamentCategory   TournamentCategory @relation(fields: [tournamentCategoryId], references: [id])

  stage TournamentMatchStage @default(GROUP)

  groupId String?
  group   TournamentGroup? @relation(fields: [groupId], references: [id])

  // Slice 3 additions — only ever set on a KNOCKOUT-stage match.
  knockoutRound KnockoutRound?

  teamAId String?
  teamA   TournamentTeam? @relation("TournamentMatchTeamA", fields: [teamAId], references: [id])
  teamBId String?
  teamB   TournamentTeam? @relation("TournamentMatchTeamB", fields: [teamBId], references: [id])

  status TournamentMatchStatus @default(SCHEDULED)

  winnerTeamId String?
  winnerTeam   TournamentTeam? @relation("TournamentMatchWinner", fields: [winnerTeamId], references: [id])

  // Bracket-progression pointer (slice 3): this match's winner is written
  // into nextMatch's teamAId/teamBId slot (nextMatchSlot: "A" | "B"). Self-
  // relation — a knockout match's own previous (feeder) matches are the
  // reverse side, previousMatches. Both null for a GROUP match and for the
  // bracket's FINAL.
  nextMatchId     String?
  nextMatch       TournamentMatch?  @relation("MatchProgression", fields: [nextMatchId], references: [id])
  nextMatchSlot   String?
  previousMatches TournamentMatch[] @relation("MatchProgression")

  // Informational only in this pass — no integration with the Court/
  // Reservation booking system (see the plan's explicit decision).
  scheduledAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sets MatchSet[]

  @@index([tournamentCategoryId, stage])
  @@index([groupId, status])
  @@index([nextMatchId])
  @@map("tournament_matches")
}

model MatchSet {
  id      String          @id @default(cuid())
  matchId String
  match   TournamentMatch @relation(fields: [matchId], references: [id])

  setNumber           Int
  teamAGames          Int
  teamBGames          Int
  // Optional per the plan ("optional tiebreak points") — slice 2's loose
  // scoring rules never require these to derive a winner.
  teamATiebreakPoints Int?
  teamBTiebreakPoints Int?

  createdAt DateTime @default(now())

  @@unique([matchId, setNumber])
  @@map("match_sets")
}
