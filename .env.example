# =============================================================================
# play-padel — environment variables
# =============================================================================
# Copy this file to .env.local and fill in real (sandbox/dev) values. Never
# commit .env.local. Production values are set directly in Vercel's dashboard
# (Project → Settings → Environment Variables) under the same variable names —
# see .env.prod for a local reference checklist of what belongs there.

# --- Database (Neon / Prisma) -----------------------------------------------
# Environment variables declared here are NOT automatically loaded by Prisma.
# Add `import "dotenv/config";` to prisma.config.ts, or use the Prisma CLI with
# Bun: https://pris.ly/prisma-config-env-vars.
# Connection string docs: https://pris.ly/d/connection-strings
# Keep Neon credentials secure — never expose to client-side code.
DATABASE_URL=

#Resend API Key
RESEND_API_KEY=

# --- Clerk (auth) ------------------------------------------------------------
# Clerk issues a separate key pair per environment — these are your Clerk
# "Development" instance keys. Production uses its own "Production" instance
# keys (set in Vercel), never these ones.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Mercado Pago (platform credentials) --------------------------------------
# DevPanel → your app → Credenciales → Prueba (sandbox) for local dev.
# Production uses the same app's Credenciales → Producción values instead.
MERCADOPAGO_ACCESS_TOKEN=
# Public key for @mercadopago/sdk-react (CardPayment Brick, client-side card
# tokenization for monthly membership checkout). DevPanel → app → Credenciales
# → Public Key.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Without this, the webhook route rejects every notification as an invalid
# signature. DevPanel → app → Webhooks → Configurar notificaciones.
MERCADOPAGO_WEBHOOK_SECRET=
# OAuth client id/secret for the club "connect your Mercado Pago account" flow.
# Client ID is not secret; the client secret is.
MERCADOPAGO_OAUTH_CLIENT_ID=
MERCADOPAGO_OAUTH_CLIENT_SECRET=
# Encrypts each club's OAuth tokens at rest (AES-256-GCM). Generate with:
# openssl rand -base64 32
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=
# Signs/validates the OAuth `state` parameter (anti-CSRF). Generate with:
# openssl rand -base64 32
MERCADOPAGO_OAUTH_STATE_SECRET=

# --- Club membership billing --------------------------------------------------
# Rollout-safety kill switch: membership gating is opt-in. Unset, or anything
# other than the literal string "true", makes requireMembershipPaid a no-op
# pass-through (ok: true always) so the feature can ship dark and be flipped
# on deliberately once verified (or back off during an incident).
MEMBERSHIP_GATING_ENABLED=

# --- Vercel Cron ---------------------------------------------------------------
# Authenticates the cron jobs (notifications, mercadopago-token-refresh,
# membership-grace-sweep). Generate with: openssl rand -base64 32.
# In production, Vercel generates and injects this automatically once you
# configure a Cron Job — you don't set it by hand there.
CRON_SECRET=

# --- Vercel Blob -----------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
# OIDC token so serverless functions can access Vercel Blob.
VERCEL_OIDC_TOKEN=

# --- Amplitude -----------------------------------------------------------------
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# --- App -----------------------------------------------------------------------
# http://localhost:3000 locally; your real domain in production.
NEXT_PUBLIC_APP_URL=
