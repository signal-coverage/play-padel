# =============================================================================
# DEV (local)
# =============================================================================

# --- Database (Neon / Prisma) ---
# Environment variables declared in this file are NOT automatically loaded by
# Prisma. Add `import "dotenv/config";` to `prisma.config.ts`, or use the
# Prisma CLI with Bun: https://pris.ly/prisma-config-env-vars.
# Connection string docs: https://pris.ly/d/connection-strings
# Keep Neon credentials secure — never expose to client-side code.
DATABASE_URL=
DIRECT_URL=

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Mercado Pago ---
# App access token/webhook secret — DevPanel → "Play Padel" → Credenciales (Prueba).
MERCADOPAGO_ACCESS_TOKEN=
# Sin esto, el webhook rechaza TODAS las notificaciones como firma inválida.
MERCADOPAGO_WEBHOOK_SECRET=
# Client ID de la app (no es secreto).
MERCADOPAGO_OAUTH_CLIENT_ID=
MERCADOPAGO_OAUTH_CLIENT_SECRET=
# Cifra los tokens OAuth de cada club en reposo (AES-256-GCM). Generado ahora:
MP_TOKEN_ENCRYPTION_KEY=
# Firma/valida el parámetro `state` del OAuth (anti-CSRF). Generado ahora:
MP_OAUTH_STATE_SECRET=
# Public key de tu app — hoy no la usa ningún código (Checkout Pro no la necesita).
# Dejala comentada salvo que sumes un formulario de tarjeta embebido en el futuro.
# MERCADOPAGO_PUBLIC_KEY=

# --- Vercel Cron ---
# Autentica los cron jobs (notifications + mercadopago-token-refresh). Generado ahora:
CRON_SECRET=

# --- Vercel Blob ---
BLOB_READ_WRITE_TOKEN=
# Token OIDC para que funciones serverless accedan a Vercel Blob.
VERCEL_OIDC_TOKEN=

# --- Amplitude ---
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=


# =============================================================================
# PROD (Vercel) — completar al deployar, no en este archivo
# =============================================================================

# --- Clerk ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SIGNING_SECRET=

# --- Mercado Pago ---
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_OAUTH_CLIENT_ID=4084076041937937
# MERCADOPAGO_OAUTH_CLIENT_SECRET=
# MP_TOKEN_ENCRYPTION_KEY=
# MP_OAUTH_STATE_SECRET=

# --- Vercel Cron ---
# CRON_SECRET=   (Vercel la genera sola si configurás el Cron Job)

# --- App ---
# NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# Bearer secret guarding the admin membership-trial-config route
# (app/api/admin/membership-trial-config). Generate with: openssl rand -base64 32
MEMBERSHIP_ADMIN_SECRET=

# Signature secret for the membership webhook (app/api/webhooks/mercadopago/membership),
# separate from MERCADOPAGO_WEBHOOK_SECRET (reservation webhook). DevPanel -> app ->
# Webhooks -> "Planes y suscripciones" topic -> signature secret.
MERCADOPAGO_MEMBERSHIP_WEBHOOK_SECRET=

# Public key for @mercadopago/sdk-react (CardPayment Brick, client-side card tokenization
# for monthly membership checkout). DevPanel -> app -> Credenciales -> Public Key.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Rollout-safety kill switch (see design.md's "Migration / Rollout" decision, Phase 10):
# membership gating for MP-connect (lib/mercadopago/membershipStatus.ts) is opt-in.
# Unset, or anything other than the literal string "true", makes requireMembershipPaid
# a no-op pass-through (ok: true always) so the feature can ship dark and be flipped
# on deliberately once verified in prod (or flipped back off during an incident).
MEMBERSHIP_GATING_ENABLED=
